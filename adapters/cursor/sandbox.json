{
  "type": "workspace_readwrite",
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "registry.npmjs.org",
      "pypi.org",
      "files.pythonhosted.org",
      "github.com",
      "api.github.com",
      "objects.githubusercontent.com",
      "*.docker.io",
      "ghcr.io"
    ]
  }
}
